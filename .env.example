GEMINI_API_KEY=your_gemini_api_key_here

# Option 3: OpenAI (paid)
# OPENAI_API_KEY=your_openai_api_key_here

API_URL=http://localhost:8000
MLFLOW_TRACKING_URI=http://localhost:5000
